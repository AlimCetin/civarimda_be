# ============================================
# DOCKER COMPOSE ENVIRONMENT VARIABLES
# ============================================
# Bu dosyayı .env olarak kopyalayın ve değerleri güncelleyin
# Docker Compose otomatik olarak .env dosyasını okur
#
# Kullanım:
#   cp docker.env.example .env
# 
# Sonra .env dosyasını düzenleyip JWT_SECRET ve diğer değerleri ayarlayın

# ============================================
# PostgreSQL Settings
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=civarimda
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civarimda

# MongoDB Source Settings (Mevcut verileri PostgreSQL'e aktarmak için kullanılır)
MONGODB_URI=mongodb://localhost:27017/civarimda

# ============================================
# Redis Settings
# ============================================
# Redis port (varsayılan: 6379)
REDIS_PORT=6379

# Redis password (opsiyonel, production için önerilir)
REDIS_PASSWORD=

# Redis URL (otomatik oluşturulur, manuel set etmek isterseniz)
# REDIS_URL=redis://:password@redis:6379

# ============================================
# Backend Settings
# ============================================
# Backend port (varsayılan: 3000)
BACKEND_PORT=3000

# Node environment (development, production)
NODE_ENV=production

# JWT Secret (ZORUNLU! Minimum 32 karakter, production için 64+ önerilir)
# Örnek: openssl rand -base64 64
JWT_SECRET=u0HQ07DG8ke4ymTL4a3xwUH9LQdZOGQMnelvUwLq+meI65uJgLXzSOLy5y5jV4gb26eCYOwf0sLccatCsnlySg==

# MongoDB URI (otomatik oluşturulur, manuel set etmek isterseniz)
# MONGODB_URI=mongodb://username:password@mongodb:27017/civarimda?authSource=admin

# CORS Origin (virgülle ayrılmış, * tüm originlere izin verir)
# Örnek: http://localhost:3000,http://localhost:19006,http://10.0.2.2:3000
CORS_ORIGIN=*

# ============================================
# GÜVENLİK NOTLARI
# ============================================
# 1. .env.docker dosyası .gitignore'da olmalı (commit etmeyin!)
# 2. Production'da MUTLAKA MongoDB username/password set edin
# 3. Production'da port'ları dışarıya açmayın (internal network kullanın)
# 4. Güçlü şifreler kullanın (minimum 16 karakter)

